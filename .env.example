# Past Graph — environment template (copy to .env.local and fill)
# NEVER put real secrets in NEXT_PUBLIC_* variables.

# Supabase (from Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: bypasses RLS for payment flips and claim approvals
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (either name works; used by /api/ai/chat and /api/ai/hint)
GEMINI_API_KEY=
# optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Paystack — test keys first (sk_test_… / pk_test_…)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Public URL of this deployment (used for checkout callback)
NEXT_PUBLIC_APP_URL=

# Manual bank-transfer fallback shown on /pricing (public by design)
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
